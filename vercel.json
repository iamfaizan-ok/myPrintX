{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/user_frontend/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/pages/:path*",
      "destination": "/admin/pages/:path*"
    },
    {
      "source": "/admin/css/:path*",
      "destination": "/admin/css/:path*"
    },
    {
      "source": "/admin/js/:path*",
      "destination": "/admin/js/:path*"
    },
    {
      "source": "/pages/:path*",
      "destination": "/user_frontend/pages/:path*"
    },
    {
      "source": "/css/:path*",
      "destination": "/user_frontend/css/:path*"
    },
    {
      "source": "/js/:path*",
      "destination": "/user_frontend/js/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "/user_frontend/assets/:path*"
    }
  ]
}
